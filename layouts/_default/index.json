{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) (ne .Layout `page`) }}
    {{- $pg := . -}}
    {{- $cover := "" -}}
    {{- with .Params.cover -}}{{- with .image -}}{{- $cover = printf "%s%s" $pg.Permalink . -}}{{- end -}}{{- end -}}
    {{- $index = $index | append (dict
      "title" $pg.Title
      "permalink" $pg.Permalink
      "summary" ($pg.Summary | plainify | truncate 120)
      "date" ($pg.Date.Format "2006-01-02")
      "cover" $cover
    ) -}}
    {{- end }}
{{- end -}}
{{- $index | jsonify -}}
