{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
  {{- $now := now }}
  {{- $cutoff := $now.AddDate 0 0 -2 }}
  {{- range where (where .Site.RegularPages "Kind" "page") "Date" "ge" $cutoff }}
  {{- $lang := "ko" }}
  {{- if strings.Contains .RelPermalink "japan-trends" }}{{- $lang = "ja" }}{{- end }}
  {{- if strings.Contains .RelPermalink "us-trends" }}{{- $lang = "en" }}{{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <news:news>
      <news:publication>
        <news:name>트렌드줌</news:name>
        <news:language>{{ $lang }}</news:language>
      </news:publication>
      <news:publication_date>{{ .Date.Format "2006-01-02T15:04:05+09:00" | safeHTML }}</news:publication_date>
      <news:title>{{ .Title | html }}</news:title>
    </news:news>
  </url>
  {{- end }}
</urlset>
