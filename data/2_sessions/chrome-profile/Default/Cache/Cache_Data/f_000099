} 2025-10-15 삭제 */
@media (max-width:900px){/*공통 - m_gnb*/
    #kakaoHead{height:50px}
    #kakaoHead h1{padding:17px 0 0 21px}
    #kakaoLogo{width:110px;background:url(https://t1.daumcdn.net/biz/ui/adfit/main/m/logo_adfit2.png) no-repeat;background-size:110px 16px}
    .gnb_menu{display:none}
    /*공통 - m_footer*/
    .kakao_foot{overflow:hidden;height:90px}
    .kakao_copyright{display:none}
    .m_kakao_copyright{display:block}
    .kakao_foot .list_policy{position:relative;top:auto;right:auto;padding-top:15px;margin-right:-15px}
    .kakao_foot .list_policy li + li:after{height:10px}
    .kakao_foot .list_policy .link_policy{padding:5px 15px;font-size:11px;line-height:16px}
    /*공통 - m_main*/
    #mArticle{padding-top:50px}
    .wrap_adfit{display:none}
    /*공통 - m_section*/
    .m_view{display:block}
    .pc_view{display:none}
    /* 2025-10-15 추가 */
    .inner_section{width:100%;padding-left:20px;padding-right:20px;box-sizing:border-box}
    .inner_section .tit_g{font-size:18px;line-height:27px;text-align:left}
    .inner_section .desc_g{padding-top:8px;font-size:14px;line-height:23px;text-align:left} }
/*상단 배너*/
.section_intro{min-height:452px;padding:81px 0 99px;background:#02143F;box-sizing:border-box}
.section_intro .inner_section{width:100%;padding:0}
.section_intro .tit_info{display:block;font-size:42px;line-height:62px;color:#fff;font-weight:700;text-align:center}
.section_intro .desc_info{display:block;padding-top:19px;font-size:22px;line-height:34px;color:#fff;font-weight:300;text-align:center}
.section_intro .wrap_info{padding-top:74px}
.section_intro .img_intro{display:block;width:417px;height:49px;margin:0 auto;background:url(https://t1.daumcdn.net/biz/ui/adfit/main/img_intro.png) no-repeat;background-size:417px 49px}
/*tab*/
.section_tab{padding-top:75px;height:56px;text-align:center}
.section_tab .list_tab{overflow:hidden;display:inline-block}
.section_tab li{float:left;margin:0 16px}
.section_tab li .link_tab{display:block;position:relative;height:33px;font-size:20px;line-height:30px;color:#444;font-weight:500;text-decoration:none}
.section_tab li .link_tab:after{display:none;position:absolute;bottom:1px;left:0;right:0;height:1px;background:#444;content:''}
.section_tab li:hover .link_tab:after{display:block}
.section_tab li.on .link_tab{color:#4374CF}
.section_tab li.on .link_tab:after{display:block;bottom:0;height:2px;background:#4374CF}
.tab_fixed .inner_section{position:fixed;top:60px;left:0;right:0;z-index:10;width:100%;height:57px;padding:10px 0 9px;border-top:1px solid rgba(0,0,0,0.05);border-bottom:1px solid rgba(0,0,0,0.05);background:rgba(255,255,255,0.85);box-sizing:border-box}
/*주요특징*/
.section_cont .inner_section{padding-bottom:160px}
.section_cont .item_cont{padding-top:160px}
.section_cont .item_cont:first-child{padding-top:97px}
.section_cont .tit_cont{display:block;font-size:30px;line-height:43px;color:#222;font-weight:500;letter-spacing:-0.02em}
.section_cont .desc_cont{padding-top:7px;font-size:22px;line-height:38px;color:#444;font-weight:300;text-align:left}
.section_cont .thumb_cont{padding-top:30px}
.section_cont .thumb_cont .inner_thumb{width:100%;max-width:1090px;border-radius:20px;background:#F0F1F4}
/* 2025-10-15 수정 */
.section_cont .thumb_cont .thumb_g{width:100%}
/* 2025-10-15 추가 시작 */
/* 슬라이드 */
.wrap_slide{padding-top:30px}
.wrap_slide .inner_slide{overflow:hidden;position:relative;border-radius:20px;background:#F0F1F4}
.wrap_slide .slide_box{display:flex;transition:transform 0.6s cubic-bezier(1,0.01,0.32,1)}
.wrap_slide .slide_item{flex:0 0 100%;width:100%}
.wrap_slide .slide_item .thumb_g{display:block;width:100%}
/* 슬라이드 - 이전,다음 버튼 */
.slide_controls .btn_control{position:absolute;top:50%;transform:translateY(-50%);width:60px;height:60px;border:2.5px solid rgba(165,177,197,0.85);border-radius:50%;box-sizing:border-box}
.slide_controls .btn_prev{left:40px}
.slide_controls .btn_next{right:40px}
.slide_controls .btn_control:hover{border-color:#326EDC}
.slide_controls .btn_control .ico_controls{display:block;width:14px;height:14px;margin-left:16px;border-top:3px solid rgba(165,177,197,0.85);border-right:3px solid rgba(165,177,197,0.85);-webkit-transform:rotate(45deg);transform:rotate(45deg)}
.slide_controls .btn_control:hover .ico_controls{border-color:#326EDC}
.slide_controls .btn_prev .ico_controls{margin-left:22px;-webkit-transform:rotate(45deg) scale(-1);transform:rotate(45deg) scale(-1)}
/* 슬라이드 - 페이징 */
.util_slide{padding:30px 10px 0}
.util_slide .paging_slide .inner_paging{display:flex}
.util_slide .paging_slide .btn_paging{width:30px;height:30px;margin-right:10px;padding-bottom:2px;border:1px solid rgba(165,177,197,0.85);border-radius:7px;font-weight:500;font-size:15px;color:#A5B1C5;background:#fff}
.util_slide .paging_slide .btn_paging:hover,.util_slide .paging_slide .btn_paging[aria-current="true"]{border-color:#326EDC;color:#fff;background:#326EDC}
/* 슬라이드 - 컨텐츠 */
.util_slide .cont_slide{padding-top:20px;letter-spacing:-0.2px}
.util_slide .cont_slide .tit_slide{display:block;font-weight:500;font-size:20px;line-height:30px;color:#326EDC}
.util_slide .cont_slide .desc_slide{display:block;padding-top:7px;font-weight:300;font-size:20px;line-height:32px;min-height:84px}
