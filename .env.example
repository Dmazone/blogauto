# ──────────────────────────────────────────────────
# BlogAuto 환경변수 설정 (.env.example)
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채우세요.
# .env 파일은 절대 git에 커밋하지 마세요!
# ──────────────────────────────────────────────────

# [필수] Anthropic Claude API Key
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# [필수] Google Gemini API Key
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# [선택] NanoBanana 이미지 생성 API
# 미설정 시 Pollinations.ai(무료)로 자동 fallback
NANOBANANA_API_KEY=
NANOBANANA_API_URL=https://api.nanobanana.io/v1/generate

# [선택] 디버그 모드 (에러 스택트레이스 출력)
DEBUG=false
