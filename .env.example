# ──────────────────────────────────────────────────
# BlogAuto 환경변수 설정 (.env.example)
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채우세요.
# .env 파일은 절대 git에 커밋하지 마세요!
# ──────────────────────────────────────────────────

# [필수] Anthropic Claude API Key
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# [필수] Google Gemini API Key
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# [선택] NanoBanana 이미지 생성 API
# 미설정 시 Pollinations.ai(무료)로 자동 fallback
NANOBANANA_API_KEY=
NANOBANANA_API_URL=https://api.nanobanana.io/v1/generate

# [선택] 디버그 모드 (에러 스택트레이스 출력)
DEBUG=false

# ──────────────────────────────────────────────────
# SNS 자동 홍보 (STEP 8) — 각 플랫폼 선택적 설정
# 미설정 플랫폼은 자동으로 건너뜁니다
# ──────────────────────────────────────────────────

# 블로그 기본 URL (필수 — SNS 홍보 링크로 사용)
BLOG_BASE_URL=https://dmazone.github.io/blogauto

# GitHub Pages 배포 후 SNS 홍보 전 대기 시간 (초, 기본 90)
SNS_DEPLOY_WAIT_SEC=90

# Instagram + Threads (Meta Graph API 공용 토큰)
# 발급: developers.facebook.com → 앱 생성 → Instagram Graph API → 장기 액세스 토큰 생성
META_ACCESS_TOKEN=
META_IG_USER_ID=          # Instagram 비즈니스/크리에이터 계정 User ID
META_THREADS_USER_ID=     # Threads User ID (없으면 META_IG_USER_ID 사용)

# Pinterest
# 발급: developers.pinterest.com → 앱 생성 → OAuth 토큰 발급
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=       # 핀을 올릴 보드 ID (보드 URL에서 확인)
