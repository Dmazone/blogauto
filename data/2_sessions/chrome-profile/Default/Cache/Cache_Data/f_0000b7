/* header */
#kakaoHead{position:fixed;left:0;top:0;z-index:990;display:flex;align-items:center;justify-content:space-between;width:100%;height:70px;padding:12px 24px 12px 30px;background-color:#fff;border-bottom:1px solid #eee;box-sizing:border-box}
#kakaoHead h1{flex:none;position:relative;z-index:0;width:348px;min-height:24px;font-weight:400;font-size:16px}
#kakaoLogo{float:left;width:99px;height:16px;margin-top:2px;background:url(//t1.daumcdn.net/biz/ui/adfit/logo_adfit_251124.png) no-repeat;background-size:99px auto;text-decoration:none}
#kakaoHead h1 .tit_service{display:inline-block;min-width:157px;height:19px;margin:3px 0 0 13px;font-size:16px;line-height:19px;color:#949494;font-weight:700;vertical-align:top}
#kakaoHead h1 .tit_service .thumb_service{display:block;height:19px}
#kakaoHead h1 .tit_service:hover{text-decoration:none}
#kakaoHead h1 .tit_service.type_small{font-size:13px}/** gnb **/
.gnb_comm{flex:1 0 auto;float:left;height:70px}
.gnb_comm .list_gnb{height:70px}
.gnb_comm .list_gnb li{float:left;position:relative}
.gnb_comm .list_gnb .link_gnb{display:block;height:100%;padding:0 20px;line-height:70px;font-size:16px;color:#191919;font-weight:400}
.gnb_comm .list_gnb li:first-child .link_gnb{padding-right:26px}
.gnb_comm .list_gnb .link_gnb:hover{font-weight:700;text-decoration:none}
.gnb_comm .list_gnb .on .link_gnb{font-weight:700}
.gnb_comm .list_gnb .link_gnb .ico_gnb{width:16px;height:16px;margin:27px 0 0 4px;background-position:-60px -25px}
.gnb_comm .list_gnb .link_gnb:hover .ico_gnb,.gnb_comm .list_gnb li.on .link_gnb .ico_gnb{background-position:-80px -25px}
.gnb_comm .list_gnb li.open .link_gnb .ico_gnb{transform:rotate(180deg)}
/* gnb - 서브메뉴 */
.kakao_head .sub_gnb{display:none;position:absolute;left:-3px;top:61px;min-width:210px;width:max-content;height:198px;padding:15px;background-color:#fff;border:1px solid rgba(0,0,0,0.06);box-shadow:0 4px 16px 0 rgba(0,0,0,0.12);border-radius:12px;z-index:10;box-sizing:border-box}
