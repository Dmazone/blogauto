.account_info .user_info .tit_account{display:table-cell;width:131px;height:36px;max-height:40px;padding:0 40px 0 0;margin:0;font-size:12px;line-height:18px;font-weight:500;color:#222;text-align:left;vertical-align:middle;cursor:pointer}
