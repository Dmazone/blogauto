.cont_info .on .tit_account .ico_arrow{background-position:-150px 0}
.account_info .desc_account{overflow:hidden;padding-bottom:16px;font-size:12px;line-height:18px;color:#222;text-overflow:ellipsis;white-space:nowrap}
.account_info .ad_info{padding:16px 24px}
.account_info .ad_info .item_info{font-size:12px;line-height:18px}
.account_info .ad_info .item_info:after{content:'';overflow:hidden;display:block;clear:both}
.account_info .item_info + .item_info{margin-top:6px}
.account_info .item_info .tit_item{float:left;color:#757B93;font-weight:300}
.account_info .item_info .txt_item{position:relative;float:right;margin-left:-3px;color:#444}
