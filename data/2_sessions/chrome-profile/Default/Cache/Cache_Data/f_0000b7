/* LNB */
#mFeature{position:fixed;left:0;top:70px;bottom:0;z-index:100;background-color:#fff;transition:width 0.2s ease}
#mFeature:after{content:'';position:absolute;right:0;top:0;bottom:0;width:1px;background-color:#E3E4E9}
.feature_wrap{position:relative;overflow:hidden;height:calc(100% - 60px);width:60px;box-sizing:border-box}
/* 2025-11-24 수정 */
.feature_wrap .cont_info{display:block;/*height:41px;*/ border-bottom:1px solid #E3E4E9;transition:height 0.2s ease}
/* 상단 타이틀 */
.account_thumb{display:block;width:60px;height:auto;text-align:center;border-bottom:0 none}
.account_thumb .ico_gnb{width:36px;height:17px;margin:12px 0;background-position:-90px -50px}
.account_thumb .tit_service{display:none;height:41px;font-size:14px;font-weight:500;line-height:41px;color:#555;border-bottom:1px solid #E3E4E9;color:#222;font-weight:500;text-align:center}
/* 사용자 정보 */
