@charset "UTF-8";/* main 페이지 전용 */
/* main reset */
/* reset */
article,aside,footer,header,hgroup,main,nav,section{display:block}
body,div,dl,dt,dd,ul,ol,li,h1,h2,h3,h4,h5,h6,pre,code,form,fieldset,legend,textarea,p,blockquote,th,td,input,select,textarea,button{margin:0;padding:0}
fieldset,img{border:0 none}
dl,ul,ol,menu,li{list-style:none}
blockquote,q{quotes:none}
blockquote:before,blockquote:after,q:before,q:after{content:'';content:none}
input,select,textarea,button{vertical-align:middle}
input::-ms-clear{display:none}
button{border:0 none;background-color:transparent;cursor:pointer}
body{-webkit-text-size-adjust:100%;background:#fff}
body,th,td,input,select,textarea,button{font-size:14px;line-height:1.5;font-family:'Noto Sans KR','Apple SD Gothic Neo','Malgun Gothic','맑은 고딕',sans-serif;color:#555;word-break:break-all}
a{color:#111;text-decoration:none;cursor:pointer}
a:active,a:hover{text-decoration:underline}
a:active{background-color:transparent}
address,caption,cite,code,dfn,em,var{font-style:normal;font-weight:400}
img{vertical-align:top}
strong,b,th,h1,h2,h3,h4,h5,h6{font-weight:700}
button::-moz-focus-inner,input[type="reset"]::-moz-focus-inner,input[type="button"]::-moz-focus-inner,input[type="submit"]::-moz-focus-inner,input[type="file"] > input[type="button"]::-moz-focus-inner{padding:0;border:0}
/* global */
#kakaoIndex{overflow:hidden;position:absolute;left:-9999px;width:0;height:1px;margin:0;padding:0}
.ir_pm{display:block;overflow:hidden;font-size:0;line-height:0;text-indent:-9999px}
/* pc용 */
.ir_wa{display:block;overflow:hidden;position:relative;z-index:-1;width:100%;height:100%}
.screen_out{overflow:hidden;position:absolute;width:0;height:0;line-height:0;text-indent:-9999px}
.show{display:block}
.hide{display:none}
caption.screen_out{position:relative}
/* Background Image - common 요소 */
.ico_main{display:block;overflow:hidden;font-size:0;line-height:0;background:url(https://t1.daumcdn.net/biz/ui/adfit/main/ico_main.png) no-repeat;background-size:150px 150px;text-indent:-9999px;vertical-align:top}
/* 대체텍스트가 있는 아이콘 */
@media (max-width:900px){.ico_main{background:url(https://t1.daumcdn.net/biz/ui/adfit/main/m/ico_main.png) no-repeat;background-size:50px 50px} }
/* main */
/*공통 - gnb*/
#kakaoHead{position:fixed;left:0;top:0;z-index:1100;width:100%;height:60px;background-color:#fff}
#kakaoHead h1{float:left;position:relative;z-index:0;padding:23px 0 0 24px;font-weight:400;font-size:14px}
#kakaoLogo{float:left;width:104px;height:16px;text-decoration:none;background:url(https://t1.daumcdn.net/biz/ui/adfit/main/logo_adfit2.png) no-repeat;background-size:104px 16px}
.gnb_menu{position:absolute;top:13px;right:30px}
.gnb_menu .link_gnb{float:left;font-size:14px;line-height:34px;color:#444}
.gnb_menu .link_gnb .ico_gnb{float:right;width:10px;height:10px;margin:12px 0 0 3px;background-position:0 -35px}
.gnb_menu .link_login{float:left;width:125px;height:34px;margin-left:20px;border:1px solid rgba(2,20,63,0.15);border-radius:5px;font-size:13px;color:#444;line-height:31px;text-align:center;box-sizing:border-box}
.gnb_menu .link_login:hover{border:1px solid rgba(2,20,63,0.25);color:#222;font-weight:500;text-decoration:none}
/*공통 - footer*/
.kakao_foot{position:relative;height:54px;background:#fff}
.kakao_copyright{position:absolute;top:19px;left:30px}
.kakao_copyright .logo_corp{float:left;width:51px;height:16px}
.kakao_copyright .logo_corp .ico_logo{display:block;height:16px;font-size:0;line-height:0;background:url(https://t1.daumcdn.net/biz/ui/adfit/main/logo_kakao.png);background-size:51px 16px}
.txt_copyright{float:left;padding:1px 0 0 14px;font-size:12px;color:#818181;line-height:16px}
.m_kakao_copyright{display:none}
.m_kakao_copyright .txt_copyright{padding-top:11px;font-size:11px;line-height:16px;color:#02143F}
.kakao_foot .list_policy{overflow:hidden;position:absolute;top:12px;right:32px}
.kakao_foot .list_policy li{float:left;position:relative}
.kakao_foot .list_policy li + li:after{position:absolute;top:9px;left:0;width:1px;height:14px;background:#E3E4E9;content:''}
.kakao_foot .list_policy .link_policy{display:block;padding:5px 17px;font-size:13px;line-height:20px;color:#444}
/*공통 - main*/
#mArticle{padding:60px 0 0 0}
.wrap_adfit{position:fixed;right:60px;bottom:114px;z-index:100}
.wrap_adfit .btn_adfit{position:relative;display:inline-block;height:60px;line-height:60px;padding:0 74px 0 34px;margin-right:1px;border-radius:35px;font-size:18px;color:#fff;background:rgba(36,62,120,0.8)}
.wrap_adfit .btn_adfit:hover{background:rgba(77,134,238,0.8);text-decoration:none}
.wrap_adfit .btn_adfit .icon_plus{position:absolute;top:0;right:-1px;width:60px;height:60px;border-radius:30px;background:#19234B}
.wrap_adfit .btn_adfit:hover .icon_plus{background:#2f6ad7}
.wrap_adfit .btn_adfit .icon_plus .ico_main{display:block;width:18px;height:18px;margin:21px auto 0;background-position:-80px -35px}
/*공통 -section*/
.fw_bold{font-weight:700}
/* 폰트굵게 */
.m_view{display:none}
.inner_section{max-width:1090px;margin:0 auto;padding:0 30px}
/* 2025-10-15 수정 */
.inner_section .tit_g{display:block;font-size:30px;line-height:43px;color:#222;font-weight:500;letter-spacing:-0.02em;text-align:center}
.inner_section .desc_g{padding-top:7px;font-size:22px;line-height:36px;color:#444;font-weight:300;text-align:center}
