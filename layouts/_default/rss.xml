{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} — {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description | default .Site.Title }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.LanguageCode }}</language>
    <managingEditor>ekaledma@gmail.com (트렌드줌)</managingEditor>
    <webMaster>ekaledma@gmail.com (트렌드줌)</webMaster>
    {{ if not .Date.IsZero }}<lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    <ttl>60</ttl>
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{ range .Pages }}
    {{- $slug := .File.ContentBaseName -}}
    {{- $thumb := .Resources.GetMatch (printf "%s-thumb.webp" $slug) -}}
    <item>
      <title>{{ .Title | html }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <author>ekaledma@gmail.com (트렌드줌)</author>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description><![CDATA[{{ .Content }}]]></description>
      {{- if $thumb }}
      <media:content url="{{ $thumb.Permalink }}" medium="image" type="image/webp" width="1280" height="720"/>
      <media:thumbnail url="{{ $thumb.Permalink }}" width="1280" height="720"/>
      {{- end }}
    </item>
    {{ end }}
  </channel>
</rss>
