.kakao_head .sub_gnb .list_gnbsub{display:grid;grid-template-rows:repeat(4,auto);grid-auto-flow:column;column-gap:30px;min-width:max-content}
.kakao_head .list_gnbsub li{float:none;min-width:180px}
.kakao_head .list_gnbsub li .link_sub{display:block;min-height:42px;padding:0 12px;font-size:15px;line-height:41px;color:#191919;text-decoration:none;white-space:nowrap;border-radius:6px}
